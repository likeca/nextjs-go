# Copy to your environment (or export). Same DATABASE_URL Django reads.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lhchub
PORT=8080
LOG_LEVEL=info
MEDIA_PATH=/media/

# HMAC key for HS256 JWT signing/verification. Generate with: openssl rand -hex 32
JWT_SECRET=

# Next.js origin (Stripe success/cancel redirects, email links).
FRONTEND_URL=http://localhost:3000
